# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# --- Node ---
node_modules/
npm-debug.log*

# --- paper-fetcher runtime data ---
# Ignore everything under input/ and output/ by default. Whitelist:
#   - .gitkeep (so the dirs ship in the repo as placeholders)
#   - small curated example files at output/ top level
# Anything else (PDFs, intermediate dirs, UUID dirs, logs, etc.) stays local.
paper-fetcher/input/*
!paper-fetcher/input/.gitkeep

paper-fetcher/output/*
!paper-fetcher/output/.gitkeep
!paper-fetcher/output/paperlist_clean.txt
!paper-fetcher/output/paperlist_review.json
!paper-fetcher/output/decisions.json

# Local override of paper-fetcher path config (each machine has its own)
paper-fetcher/config.local.json

# --- zotero-mineru runtime data ---
# Everything under output/ is generated data — never track.
zotero-mineru/output/
zotero-mineru/logs/
zotero-mineru/state.json
zotero-mineru/state.json.tmp

# Local override of zotero-mineru config (each machine has its own paths)
zotero-mineru/config.local.json

# --- scratch / probes ---
_smoke_pdfs/
_probe_*
_zotero_probe*
*.tmp

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
